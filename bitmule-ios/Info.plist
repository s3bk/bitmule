<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>bitmule</string>
    <key>NSCameraUsageDescription</key>
    <string>The camera scans a bitmule QR code to receive a file.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Direct transfers between devices on the same network.</string>
    <!-- received files show up in the Files app under "bitmule" -->
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>
    <!-- bitmule://<server>/#<link>, besides plain https links pasted or scanned -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>net.bitmule.link</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>bitmule</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
