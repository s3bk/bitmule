namespace bitmule_mobile_ffi {
  // Semver of this FFI surface. Bump on any breaking change so the
  // Kotlin / Swift shell can bail fast on mismatched .so vs bindings.
  string ffi_version();

  // Pure-function URL splitter for the paste-and-preview flow so the
  // shell can validate a link before committing to a full recv.
  [Throws=BitmuleError]
  ParsedShareUrl parse_share_url(string url);

  // Async full receive: negotiate → stream → decrypt → verify.
  [Throws=BitmuleError, Async]
  RecvOutcome recv_file(string url, string out_dir, ProgressListener on_progress);

  // Async full send. Emits `on_url` with the share URL as soon as
  // it's minted (before the transfer starts), so the caller can
  // display + copy + QR the URL while the transfer runs in the
  // background. Returns when the transfer completes.
  //
  // `multi=false` = ServeMode::Complete (exits after first receiver
  // completes). `multi=true` = ServeMode::Multi (keeps the URL live
  // for additional receivers until the caller cancels).
  //
  // `file_paths`: 1 file → streams as-is; N>=2 files → bundled into
  // an on-the-fly store-mode zip and shipped with a container flag
  // so the receiver auto-unpacks. Directory paths are NOT yet
  // accepted on the FFI (SAF picker on Android returns individual
  // file URIs; directory-tree pick is a follow-up).
  [Throws=BitmuleError, Async]
  SendOutcome send_file(string server, sequence<string> file_paths, boolean multi, UrlListener on_url);

  // PNG bytes for a QR-code render of `text`. Pure function; shell
  // decodes with BitmapFactory (Android) / UIImage (iOS).
  [Throws=BitmuleError]
  bytes qr_png_bytes(string text, u32 pixel_scale);
};

// A share URL parsed into its component parts. Mirrors the fragment
// format the web client produces and the native receiver accepts.
dictionary ParsedShareUrl {
  string server;
  string fragment;
};

// Errors surface as first-class variants over the FFI so the mobile
// shells get typed catches instead of stringly-typed error paths.
[Error]
interface BitmuleError {
  InvalidUrl(string reason);
  InvalidFragment(string reason);
  Network(string reason);
  Transport(string reason);
  Verify(string reason);
  Io(string reason);
  Unknown(string reason);
};

// Progress callbacks fire from a background tokio task; the mobile
// shell must marshal them onto the UI thread. Kotlin: Coroutine on
// Dispatchers.Main. Swift: DispatchQueue.main.async.
[Trait, WithForeign]
interface ProgressListener {
    void on_progress(u64 sent, u64 total, string name);
};

// Fires once, as soon as the share URL is minted (before transfer
// starts). Same marshaling contract as ProgressListener.
[Trait, WithForeign]
interface UrlListener {
  void on_url(string url, string session_hex, string file_name, u64 file_size);
};

// Result of a completed receive. `path` is the file the caller
// should hand off — either the received single file, OR (when
// `is_bundle` is true) a freshly-created directory into which
// the received zip-store bundle was unpacked. The bundle zip
// itself is unlinked after successful extraction; on extraction
// failure it stays and `is_bundle` is `false` so the caller can
// share the raw bytes.
//
// The mobile shell uses `path` for FileProvider (single file) or
// ACTION_SEND_MULTIPLE (bundle dir contents).
dictionary RecvOutcome {
  string path;
  u64 size;
  string name;
  boolean is_bundle;
};

// Result of a completed send. `share_url` matches what fired via
// `UrlListener.on_url` earlier — repeated here so a caller that
// discarded the listener value can still recover it. `peers_served`
// is 1 in Complete mode, N in Multi mode.
dictionary SendOutcome {
  string share_url;
  string session_hex;
  u64 peers_served;
};
